# =============================================================================
# ANIRAG ENVIRONMENT CONFIGURATION
# =============================================================================
# ⚠️  SECURITY WARNING: NEVER commit actual secrets to Git
# ⚠️  Copy this file to `.env` and replace placeholders with real values
# ⚠️  Add `.env` to `.gitignore` immediately after copying
#
# Generate API key via: python scripts/generate_api_keys.py
# =============================================================================

# ======================
# APP CONFIGURATION
# ======================
APP_NAME=ash-bot
APP_VERSION=1.0.0
ENVIRONMENT=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
API_KEY_HEADER=X-API-Key
# Generate via: python scripts/generate_api_keys.py
API_KEY=your-super-secret-api-key-here

# ======================
# SERVER SETTINGS
# ======================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ======================
# CORS ORIGINS
# ======================
# Comma-separated list of allowed origins (no spaces after commas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# ======================
# QDRANT CLOUD (Vector DB - REQUIRED FOR PHASE 1B+)
# ======================
# Get from: https://cloud.qdrant.io → Your Cluster → API Keys
# Format: https://<your-uuid>.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=https://your-uuid.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=anime_knowledge
QDRANT_VECTOR_SIZE=384

# ======================
# UPSTASH REDIS (Cache - REQUIRED FOR PHASE 2)
# ======================
# Get from: https://console.upstash.com → Databases → REST API
# Format: https://<your-db-id>.upstash.io
REDIS_URL=https://your-upstash-redis-url-here
REDIS_TOKEN=your-upstash-token-here
CACHE_TTL_SECONDS=604800
SEMANTIC_CACHE_THRESHOLD=0.95

# ======================
# GROQ LLM API (Primary - REQUIRED FOR PHASE 2)
# ======================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7

# ======================
# TOGETHER AI (Fallback - OPTIONAL)
# ======================
# Get from: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=your-together-api-key-here

# ======================
# DATA SOURCES (Jikan API - NO KEY REQUIRED)
# ======================
JIKAN_API_URL=https://api.jikan.moe/v4
JIKAN_RATE_LIMIT_PER_SECOND=3.0
ANILIST_API_URL=https://graphql.anilist.co

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=3600

# ======================
# LOGGING (Better Stack - OPTIONAL)
# ======================
# Get from: https://betterstack.com/logs → Sources → Create source
BETTERSTACK_SOURCE_TOKEN=your-betterstack-token-here

# ======================
# DEPRECATED / LEGACY VARIABLES (IGNORE FOR ANIRAG)
# ======================
# These are from previous project iterations - NOT used in AniRAG pipeline
# VECTOR_DB_PATH=./data/chroma_db
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=phi3:mini
# PREWARM_ON_STARTUP=true
# SERVE_DEMO_FRONTEND=true
# WORKERS=2

# ======================
# QUICK START GUIDE
# ======================
# 1. Copy this file: cp .env.example .env
# 2. Generate API key: python scripts/generate_api_keys.py
# 3. Set up Qdrant: https://cloud.qdrant.io (free tier)
# 4. Set up Upstash Redis: https://console.upstash.com (free tier)
# 5. Get Groq API key: https://console.groq.com/keys (free tier)
# 6. Update .env with actual values from steps 2-5
# 7. Run pipeline: python scripts/run_minimal_pipeline.py --max-anime 10 --to-qdrant
#
# For full setup instructions, see: docs/development/ingestion-pipeline.md